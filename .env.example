# Copy this to .env.local for local development, and set the same values as
# environment variables on your Vercel project for deploys.
#
# If these are left unset, the app falls back to a local JSON file at
# data/finance-entries.json so you can run `npm run dev` immediately without
# a Supabase project. Set both to switch to real persistence.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
