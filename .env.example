# Copy this to .env.local for local development, and set the same values as
# environment variables on your Vercel project for deploys.
#
# If these are left unset, the app falls back to a local JSON file at
# data/finance-entries.json so you can run `npm run dev` immediately without
# a Supabase project. Set both to switch to real persistence.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for dashboard write routes (POST/PATCH/DELETE under /api).
# Trusted writers send it as the `x-dashboard-secret` header. Set the same
# value as an environment variable on your Vercel project for deploys.
# While this is unset, writes are allowed without a secret (local dev and
# the dashboard's own log boxes keep working). Once it is set, any write
# without the matching header is rejected with a 401. Generate a long
# random value, never commit the real value, and never put it in client
# code (no NEXT_PUBLIC_ prefix).

DASHBOARD_WRITE_SECRET=
